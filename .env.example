# ===== 必须改的 =====

# 面板域名与订阅域名，用于 nginx server_name 和证书签发
# 暂无域名时留空，nginx 会退化为 IP 直连（见 nginx/conf.d/panel.conf 注释）
PANEL_DOMAIN=panel.example.com
SUB_DOMAIN=sub.example.com

# 证书通知邮箱（Let's Encrypt 到期告警）
ACME_EMAIL=you@example.com

# 阿里云 DNS API（用 DNS-01 签证书时必须，裸 IP 用不上）
# 不要把它提交到 git，不要贴到任何聊天窗口
ALICLOUD_ACCESS_KEY=
ALICLOUD_SECRET_KEY=

# ===== 业务端口（都要在云安全组放行）=====

# x-ui 面板端口，只监听 127.0.0.1，由 nginx 反代
XUI_PORT=11297
# x-ui 面板 webBasePath，保持随机串，别用默认值
XUI_BASE_PATH=/66NxE4u20ZnNYawGv7

# 订阅服务端口（x-ui 内部），对外由 nginx 的 8080 反代
SUB_PORT=80

# nginx 对外端口
NGINX_PORT=8080

# 节点端口（Reality）
XRAY_PORT=443

# SSH 端口（fail2ban 要写这个值）
SSH_PORT=21080

# ===== 白名单 =====

# fail2ban 豁免的 IP，逗号分隔。留空则只豁免回环。
# 家宽 IP 会变，换 IP 后要更新，否则可能把自己封在外面。
# 注意：这行只是给 deploy.sh 参考；实际生效的是
# fail2ban/99-custom.conf 里的 ignoreip，要同步改。
ALLOW_IPS=
